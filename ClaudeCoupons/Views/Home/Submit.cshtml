@{
    ViewBag.title = "Share Your Claude Code Passes - Claude Coupons";
    ViewBag.description = "List your spare Claude Code guest passes so someone actually uses them. Paste your claude.ai invite link; you stay in control and can retire the listing anytime.";
}
@section headTags {
    <link rel="canonical" href="https://claudecoupons.com/submit" />
}

<section class="narrow">
    <h1>Share your Claude Code passes</h1>
    <p>
        Subscribed to Claude Pro or Max? You hold a few guest passes, each worth a free week of
        Claude Pro to someone new - and if they stay subscribed, Anthropic credits <em>you</em>
        $10 in usage. Find your invite link with <code>/passes</code> in Claude Code or in the
        Claude app settings, and paste it below.
    </p>
    @if (ViewBag.error != null)
    {
        <p class="error">@ViewBag.error</p>
    }
    <form method="post" action="/submit" class="stack">
        @Html.AntiForgeryToken()
        <label for="link">Your invite link</label>
        <input type="text" id="link" name="link" required placeholder="https://claude.ai/referral/AbCd123456" />
        <button type="submit" class="btn">List my passes</button>
    </form>
    <p class="hint">
        Only <code>claude.ai/referral/…</code> links are accepted. Your listing shows a masked code
        until a signed-in visitor unlocks it; you can refresh, mark it exhausted, or remove it
        anytime from <a href="/manage">your dashboard</a>, where you'll also see how many people
        unlocked and claimed it.
    </p>
</section>
