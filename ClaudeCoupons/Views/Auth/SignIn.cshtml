@{
    ViewBag.title = "Sign in - Claude Coupons";
    ViewBag.noindex = true;
}

<section class="narrow">
    <h1>Sign in</h1>
    <p>
        One email, no password. We send you a sign-in link; clicking it is your whole signup.
        Signing in is what unlocks pass links - it keeps bots off the board and lets us retire
        exhausted passes quickly.
    </p>
    @if (ViewBag.error != null)
    {
        <p class="error">@ViewBag.error</p>
    }
    <p>
        <a class="btn btn-google" href="/signin/google?returnUrl=@Uri.EscapeDataString((string)ViewBag.returnUrl)" rel="nofollow">
            Continue with Google
        </a>
    </p>
    <p class="or-divider">or</p>
    <form method="post" action="/signin" class="stack">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.returnUrl" />
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required autofocus placeholder="you@example.com" />
        <button type="submit" class="btn">Email me a sign-in link</button>
    </form>
</section>
